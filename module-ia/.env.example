# Copier ce fichier en `.env` et renseigner les valeurs.
# Ne jamais versionner le fichier `.env`.

# ---------- Service voix ----------
VOICE_SERVICE_HOST=0.0.0.0
VOICE_SERVICE_PORT=8001
# Répertoire local des modèles (faster-whisper, MMS, Piper...)
MODELS_DIR=./models
# Modèle faster-whisper pour le français (ex. small, medium, large-v3)
WHISPER_MODEL_SIZE=
# cpu ou cuda
WHISPER_DEVICE=cpu
# Modèle MMS pour la transcription du fon
MMS_ASR_MODEL=
# Moteur de synthèse vocale : mms ou piper
TTS_ENGINE=
# Seuil de détection de voix pour Silero VAD (0.0 - 1.0)
VAD_THRESHOLD=

# ---------- Service compréhension ----------
COMPREHENSION_SERVICE_HOST=0.0.0.0
COMPREHENSION_SERVICE_PORT=8002
# Chemin vers le dictionnaire utilisé par RapidFuzz
DICTIONARY_PATH=
# Score minimal de correspondance RapidFuzz (0 - 100)
FUZZY_MATCH_THRESHOLD=

# ---------- LLM (appelé uniquement si un champ est manquant) ----------
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=
