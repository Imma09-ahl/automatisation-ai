# ============================================================
# VARIABLES D'ENVIRONNEMENT — module-ia
# ============================================================
# Copiez ce fichier en `.env` et renseignez vos vraies valeurs.
# Ne committez jamais votre fichier `.env`.
# ============================================================


# ------------------------------------------------------------
# SERVICE VOIX
# ------------------------------------------------------------

# Langue par défaut pour la transcription (fr ou fon)
VOICE_DEFAULT_LANGUAGE=fr

# Chemin local vers les modèles (si non téléchargés à la volée)
VOICE_MODELS_DIR=./models

# Périphérique de calcul : cpu ou cuda
VOICE_DEVICE=cpu

# Port d'écoute du service voix
VOICE_SERVICE_PORT=8001


# ------------------------------------------------------------
# SERVICE COMPRÉHENSION
# ------------------------------------------------------------

# Clé API du fournisseur LLM (OpenAI, Mistral, etc.)
LLM_API_KEY=your_llm_api_key_here

# Modèle LLM à utiliser
LLM_MODEL_NAME=gpt-4o-mini

# URL de base de l'API LLM (utile pour les providers alternatifs)
LLM_BASE_URL=https://api.openai.com/v1

# Seuil de similarité pour RapidFuzz (entre 0 et 100)
FUZZY_MATCH_THRESHOLD=80

# Port d'écoute du service compréhension
COMPREHENSION_SERVICE_PORT=8002


# ------------------------------------------------------------
# GÉNÉRAL
# ------------------------------------------------------------

# Environnement d'exécution : development, staging, production
APP_ENV=development

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
